=== Parse mixed tokens (conditional statement)
let x = 10, y = 15;
if (x > 5 && y < 20) {
  fn_a();
} else {
  fn_b();
}
---
LetKeyword                     1:1-1:4    0..3    "let"
Identifier                     1:5-1:6    4..5    "x"
SimpleAssignmentOperator       1:7-1:8    6..7    "="
Number                         1:9-1:11   8..10   "10"
Comma                          1:11-1:12  10..11  ","
Identifier                     1:13-1:14  12..13  "y"
SimpleAssignmentOperator       1:15-1:16  14..15  "="
Number                         1:17-1:19  16..18  "15"
StatementEnd                   1:19-1:20  18..19  ";"
IfKeyword                      2:1-2:3    20..22  "if"
OpeningParenthesis             2:4-2:5    23..24  "("
Identifier                     2:5-2:6    24..25  "x"
RelationalGreaterThanOperator  2:7-2:8    26..27  ">"
Number                         2:9-2:10   28..29  "5"
LogicalAndOperator             2:11-2:13  30..32  "&&"
Identifier                     2:14-2:15  33..34  "y"
RelationalLessThanOperator     2:16-2:17  35..36  "<"
Number                         2:18-2:20  37..39  "20"
ClosingParenthesis             2:20-2:21  39..40  ")"
OpeningBrace                   2:22-2:23  41..42  "{"
Identifier                     3:3-3:7    45..49  "fn_a"
OpeningParenthesis             3:7-3:8    49..50  "("
ClosingParenthesis             3:8-3:9    50..51  ")"
StatementEnd                   3:9-3:10   51..52  ";"
ClosingBrace                   4:1-4:2    53..54  "}"
ElseKeyword                    4:3-4:7    55..59  "else"
OpeningBrace                   4:8-4:9    60..61  "{"
Identifier                     5:3-5:7    64..68  "fn_b"
OpeningParenthesis             5:7-5:8    68..69  "("
ClosingParenthesis             5:8-5:9    69..70  ")"
StatementEnd                   5:9-5:10   70..71  ";"
ClosingBrace                   6:1-6:2    72..73  "}"

=== Parse mixed tokens (loop statement)
let sum = 0;
for (let i = 0; i < 10; i += 1) {
  for (let j = 0; j < 10; j += 1) {
    sum += i * j;
  }
}
---
LetKeyword                     1:1-1:4    0..3      "let"
Identifier                     1:5-1:8    4..7      "sum"
SimpleAssignmentOperator       1:9-1:10   8..9      "="
Number                         1:11-1:12  10..11    "0"
StatementEnd                   1:12-1:13  11..12    ";"
ForKeyword                     2:1-2:4    13..16    "for"
OpeningParenthesis             2:5-2:6    17..18    "("
LetKeyword                     2:6-2:9    18..21    "let"
Identifier                     2:10-2:11  22..23    "i"
SimpleAssignmentOperator       2:12-2:13  24..25    "="
Number                         2:14-2:15  26..27    "0"
StatementEnd                   2:15-2:16  27..28    ";"
Identifier                     2:17-2:18  29..30    "i"
RelationalLessThanOperator     2:19-2:20  31..32    "<"
Number                         2:21-2:23  33..35    "10"
StatementEnd                   2:23-2:24  35..36    ";"
Identifier                     2:25-2:26  37..38    "i"
ComplexPlusAssignmentOperator  2:27-2:29  39..41    "+="
Number                         2:30-2:31  42..43    "1"
ClosingParenthesis             2:31-2:32  43..44    ")"
OpeningBrace                   2:33-2:34  45..46    "{"
ForKeyword                     3:3-3:6    49..52    "for"
OpeningParenthesis             3:7-3:8    53..54    "("
LetKeyword                     3:8-3:11   54..57    "let"
Identifier                     3:12-3:13  58..59    "j"
SimpleAssignmentOperator       3:14-3:15  60..61    "="
Number                         3:16-3:17  62..63    "0"
StatementEnd                   3:17-3:18  63..64    ";"
Identifier                     3:19-3:20  65..66    "j"
RelationalLessThanOperator     3:21-3:22  67..68    "<"
Number                         3:23-3:25  69..71    "10"
StatementEnd                   3:25-3:26  71..72    ";"
Identifier                     3:27-3:28  73..74    "j"
ComplexPlusAssignmentOperator  3:29-3:31  75..77    "+="
Number                         3:32-3:33  78..79    "1"
ClosingParenthesis             3:33-3:34  79..80    ")"
OpeningBrace                   3:35-3:36  81..82    "{"
Identifier                     4:5-4:8    87..90    "sum"
ComplexPlusAssignmentOperator  4:9-4:11   91..93    "+="
Identifier                     4:12-4:13  94..95    "i"
FactorMultiplicationOperator   4:14-4:15  96..97    "*"
Identifier                     4:16-4:17  98..99    "j"
StatementEnd                   4:17-4:18  99..100   ";"
ClosingBrace                   5:3-5:4    103..104  "}"
ClosingBrace                   6:1-6:2    105..106  "}"
